# OpenRouter API Key for LLM-generated narrative summary
# Get a key from OpenRouter: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Gemma model configuration (default: google/gemma-4-31b-it)
# Examples: google/gemma-4-31b-it, google/gemma-4-26b-a4b-it
# OPENROUTER_MODEL=google/gemma-4-31b-it
